<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lo escribe instalar-bodega.command. No apuntes ProgramArguments a /usr/bin/python3. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.minecore.dymo-clientes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python2.7</string>
    <string>/Users/REEMPLAZA/.minecore-dymo/bridge.py</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
