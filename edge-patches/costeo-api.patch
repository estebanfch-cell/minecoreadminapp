+/* Reintento de un costeo_recibo_pk en error. No suma non_vendor_costs (el intento fallido ya lo hizo) ni reabre un costeo cerrado. */
+async function aplicarReintento(sql, imp, row, actor1) {
+  if (imp.historico || imp.prueba) throw new Error("Costeo histórico o de prueba: no se reintenta");
+  if (imp.estado === "cerrado" || imp.estado === "anulado") throw new Error("Un costeo cerrado no se toca");
+  if (!["cruzado", "aprobado", "pre_recibido", "recibido", "reabierto"].includes(imp.estado)) throw new Error("Este costeo no admite reintentar la recepción");
+  if (row.estado === "recibido") return { ya: true, recibo: row.id };
+  if (row.estado !== "error") throw new Error("Solo se reintenta un recibo con error");
+  const qty = Number(row.qty);
+  if (!(qty > 0)) throw new Error("Cantidad inválida");
+  await sql`select pg_advisory_lock(hashtext(${"rpk-retry-" + row.id}))`;
+  try {
+    const [po] = await sql`select id, order_number, non_vendor_costs from app.purchase_orders where id=${row.po_id}`;
+    if (!po) throw new Error("OC no existe");
+    const nvcAntes = Number(po.non_vendor_costs?.value || 0);
+    const antes = await movimientoYa(sql, row.po_id, po.order_number, row.product_id);
+    let hecho = false;
+    if (antes.recibido <= 1e-9 && antes.moves === 0) {
+      const [lp] = await sql`select id from app.locations where name ilike 'BODEGA PRINCIPAL' limit 1`;
+      if (!lp) throw new Error("No existe la Bodega principal");
+      await ventas("po_receive", { id: row.po_id, lineas: [{ product_id: row.product_id, quantity: qty, sublocation: row.sublocation || "", location_id: lp.id }] }, actor1);
+      hecho = true;
+    } else if (antes.recibido + 1e-9 < qty) throw new Error("Hay un movimiento parcial de esta OC; no se recibe otra vez");
+    const [nvcNow] = await sql`select non_vendor_costs from app.purchase_orders where id=${row.po_id}`;
+    const nvcDespues = Number(nvcNow?.non_vendor_costs?.value || 0);
+    const desp = await movimientoYa(sql, row.po_id, po.order_number, row.product_id);
+    if (desp.recibido + 1e-9 < qty) throw new Error("La recepción no quedó registrada");
+    await sql`update app.costeo_recibo_pk set estado='recibido', recibido_at=now(), error=null, actor=${actor1} where id=${row.id} and estado='error'`;
+    if (!["recibido", "cerrado"].includes(imp.estado)) await sql`update app.costeo_lines set qty_recibida=(select coalesce(sum(qty),0) from app.costeo_recibo_pk where line_id=${row.line_id}::uuid and estado='recibido') where id=${row.line_id}::uuid`;
+    await audit(sql, imp.id, actor1, "recibo_reintento", { recibo: row.id, po: po.order_number, qty, recibido_ahora: hecho, nvc: nvcAntes });
+    return { reintentado: true, recibido_ahora: hecho, recibo: row.id, nvc: nvcDespues, nvc_cambio: Math.abs(nvcDespues - nvcAntes) > 0.02 };
